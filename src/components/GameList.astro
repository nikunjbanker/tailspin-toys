---
import EmptyState from './EmptyState.astro';
import GameCard from './GameCard.astro';
import type { PaginatedGames } from '../lib/games';

interface Props {
  pagination: PaginatedGames;
}

const { pagination } = Astro.props;
const { items, currentPage, totalPages } = pagination;
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);
---

<div class="mb-6 flex justify-end">
  <label for="catalog-sort" class="flex items-center gap-3 text-sm text-slate-300">
    <span>Sort by</span>
    <select
      id="catalog-sort"
      name="sort"
      class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-200 focus:ring-2 focus:ring-blue-500 focus:outline-none"
      data-testid="game-sort"
    >
      <option value="title-asc">Title: A–Z</option>
      <option value="title-desc">Title: Z–A</option>
      <option value="rating-desc">Rating: highest first</option>
    </select>
  </label>
</div>

{items.length === 0 ? (
  <EmptyState text="No games available at the moment." />
) : (
  <>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
      {items.map((game) => <GameCard game={game} />)}
    </div>

    <nav
      aria-label="Game list pagination"
      data-testid="pagination"
      class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-between"
    >
      <a
        href={currentPage > 1 ? `/page/${currentPage - 1}` : '/'}
        class:list={[
          'inline-flex items-center justify-center rounded-lg border px-4 py-2 text-sm font-medium transition-colors focus:ring-2 focus:ring-blue-500 focus:outline-none',
          currentPage <= 1
            ? 'pointer-events-none border-slate-700 bg-slate-800 text-slate-500'
            : 'border-slate-600 bg-slate-800 text-slate-200 hover:border-blue-500 hover:text-blue-400',
        ]}
        data-testid="pagination-previous"
        aria-disabled={currentPage <= 1 ? 'true' : 'false'}
      >
        Previous
      </a>

      <div class="flex flex-wrap items-center justify-center gap-2">
        {pageNumbers.map((page) => (
          <a
            href={page === 1 ? '/' : `/page/${page}`}
            class:list={[
              'inline-flex h-10 w-10 items-center justify-center rounded-full border text-sm font-medium transition-colors focus:ring-2 focus:ring-blue-500 focus:outline-none',
              page === currentPage
                ? 'border-blue-500 bg-blue-600 text-white'
                : 'border-slate-600 bg-slate-800 text-slate-200 hover:border-blue-500 hover:text-blue-400',
            ]}
            data-testid={`pagination-page-${page}`}
            aria-current={page === currentPage ? 'page' : undefined}
          >
            {page}
          </a>
        ))}
      </div>

      <a
        href={currentPage < totalPages ? `/page/${currentPage + 1}` : `/page/${totalPages}`}
        class:list={[
          'inline-flex items-center justify-center rounded-lg border px-4 py-2 text-sm font-medium transition-colors focus:ring-2 focus:ring-blue-500 focus:outline-none',
          currentPage >= totalPages
            ? 'pointer-events-none border-slate-700 bg-slate-800 text-slate-500'
            : 'border-slate-600 bg-slate-800 text-slate-200 hover:border-blue-500 hover:text-blue-400',
        ]}
        data-testid="pagination-next"
        aria-disabled={currentPage >= totalPages ? 'true' : 'false'}
      >
        Next
      </a>
    </nav>
  </>
)}

<script>
  import { sortGames, type GameSort } from '../lib/sort';

  const sortSelect = document.querySelector<HTMLSelectElement>('[data-testid="game-sort"]');

  if (sortSelect) {
    const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');

    if (grid) {
      const getSortedCards = () => {
        const cardMap = new Map(
          [...grid.querySelectorAll<HTMLElement>('[data-testid="game-card"]')].map((card) => [Number(card.dataset.gameId ?? '0'), card]),
        );
        const sortValue = (sortSelect.value as GameSort) ?? 'title-asc';

        return sortGames(
          [...grid.querySelectorAll<HTMLElement>('[data-testid="game-card"]')].map((card) => ({
            id: Number(card.dataset.gameId ?? '0'),
            title: card.dataset.gameTitle ?? '',
            description: card.dataset.gameDescription ?? '',
            starRating: card.dataset.starRating === '' ? null : Number(card.dataset.starRating ?? 'null'),
            category: null,
            publisher: null,
          })),
          sortValue,
        ).map((game) => cardMap.get(game.id)).filter((card): card is HTMLElement => card !== undefined);
      };

      const sortCards = () => {
        getSortedCards().forEach((card) => { grid.appendChild(card); });
      };

      sortSelect.addEventListener('change', sortCards);
    }
  }
</script>
