---
interface FilterOption {
  id: number;
  name: string;
}

interface Props {
  categories: FilterOption[];
  publishers: FilterOption[];
}

const { categories, publishers } = Astro.props;
---

<form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
  <fieldset>
    <legend class="mb-4 text-lg font-semibold text-slate-100">Filter games</legend>

    <div class="mb-6">
      <label for="title-search" class="mb-2 block text-sm font-medium text-slate-200">Search by title</label>
      <input
        id="title-search"
        type="search"
        name="titleSearch"
        placeholder="Search games by title"
        autocomplete="off"
        class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-200 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-500 focus:outline-none"
        data-testid="title-search-input"
      />
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <span class="mb-2 block text-sm font-medium text-slate-200">Categories</span>
        <div class="flex flex-wrap gap-3">
          {categories.map((category) => (
            <label class="inline-flex items-center gap-2 text-sm text-slate-300">
              <input
                type="checkbox"
                name="category"
                value={category.id}
                class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-600 focus:ring-2 focus:ring-blue-500"
                data-testid={`filter-category-${category.id}`}
              />
              <span>{category.name}</span>
            </label>
          ))}
        </div>
      </div>
      <div>
        <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
        <select
          id="publisher-filter"
          name="publisher"
          class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-200 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="filter-publisher"
        >
          <option value="">All publishers</option>
          {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
        </select>
      </div>
    </div>
    <button
      type="reset"
      class="mt-5 rounded-lg border border-slate-600 bg-slate-800 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:border-blue-500 hover:text-blue-400 focus:ring-2 focus:ring-blue-500 focus:outline-none"
      data-testid="filter-reset"
    >
      Clear filters
    </button>
  </fieldset>
</form>
