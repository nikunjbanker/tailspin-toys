---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import GameList from '../components/GameList.astro';
import { getDatabase } from '../lib/db';
import { getGamesPage } from '../lib/games';

export const prerender = true;

const pagination = await getGamesPage(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>
      <GameList pagination={pagination} />
    </div>
  </div>
</Layout>
